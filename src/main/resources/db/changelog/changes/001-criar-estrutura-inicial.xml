<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="001-criar-tabela-usuarios" author="carteira-acao">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="usuarios"/></not>
        </preConditions>
        <createTable tableName="usuarios">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_usuarios" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="email" type="VARCHAR(160)"><constraints nullable="false"/></column>
            <column name="senha" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="papel" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="ativo" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="data_cadastro" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="usuarios" columnNames="email"
                             constraintName="uk_usuario_email"/>
        <rollback><dropTable tableName="usuarios"/></rollback>
    </changeSet>

    <changeSet id="002-criar-tabela-corretoras" author="carteira-acao">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="corretoras"/></not>
        </preConditions>
        <createTable tableName="corretoras">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_corretoras" nullable="false"/>
            </column>
            <column name="cnpj" type="VARCHAR(14)"><constraints nullable="false"/></column>
            <column name="razao_social" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="nome_fantasia" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="telefone" type="VARCHAR(255)"/>
            <column name="cep" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="logradouro" type="VARCHAR(255)"/>
            <column name="numero" type="VARCHAR(255)"/>
            <column name="complemento" type="VARCHAR(255)"/>
            <column name="bairro" type="VARCHAR(255)"/>
            <column name="cidade" type="VARCHAR(255)"/>
            <column name="uf" type="VARCHAR(2)"/>
            <column name="situacao_cadastral" type="VARCHAR(255)"/>
            <column name="validada_na_cvm" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="status_cvm" type="VARCHAR(255)"/>
            <column name="data_cadastro" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="corretoras" columnNames="cnpj"
                             constraintName="uk_corretora_cnpj"/>
        <rollback><dropTable tableName="corretoras"/></rollback>
    </changeSet>

    <changeSet id="003-criar-tabela-acoes" author="carteira-acao">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="acoes"/></not>
        </preConditions>
        <createTable tableName="acoes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_acoes" nullable="false"/>
            </column>
            <column name="ticker" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="nome_empresa" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="mercado" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="moeda" type="VARCHAR(3)"><constraints nullable="false"/></column>
            <column name="cotacao_atual" type="DECIMAL(19,4)"><constraints nullable="false"/></column>
            <column name="variacao_percentual" type="DECIMAL(10,4)"/>
            <column name="quantidade" type="DECIMAL(19,4)"/>
            <column name="preco_medio" type="DECIMAL(19,4)"/>
            <column name="data_hora_cotacao" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="data_cadastro" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="acoes" columnNames="ticker"
                             constraintName="uk_acao_ticker"/>
        <rollback><dropTable tableName="acoes"/></rollback>
    </changeSet>

    <changeSet id="004-criar-tabela-historicos-cotacao" author="carteira-acao">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="historicos_cotacao"/></not>
        </preConditions>
        <createTable tableName="historicos_cotacao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_historicos_cotacao" nullable="false"/>
            </column>
            <column name="acao_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="valor" type="DECIMAL(19,4)"><constraints nullable="false"/></column>
            <column name="data_hora" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="historicos_cotacao" baseColumnNames="acao_id"
                                 referencedTableName="acoes" referencedColumnNames="id"
                                 constraintName="fk_historico_acao"/>
        <createIndex tableName="historicos_cotacao" indexName="idx_historico_acao_data">
            <column name="acao_id"/>
            <column name="data_hora"/>
        </createIndex>
        <rollback><dropTable tableName="historicos_cotacao"/></rollback>
    </changeSet>

</databaseChangeLog>
