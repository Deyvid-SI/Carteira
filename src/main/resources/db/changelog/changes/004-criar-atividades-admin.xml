<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="007-criar-tabela-atividades-admin" author="carteira-acao">
        <createTable tableName="atividades_admin">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_atividades_admin" nullable="false"/>
            </column>
            <column name="responsavel" type="VARCHAR(160)"><constraints nullable="false"/></column>
            <column name="acao" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="conta" type="VARCHAR(160)"><constraints nullable="false"/></column>
            <column name="detalhe" type="VARCHAR(255)"/>
            <column name="data_hora" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="atividades_admin" indexName="idx_atividade_admin_data">
            <column name="data_hora"/>
        </createIndex>
        <rollback><dropTable tableName="atividades_admin"/></rollback>
    </changeSet>

</databaseChangeLog>
