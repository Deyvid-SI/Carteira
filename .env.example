# Execucao local do Spring Boot com PostgreSQL
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/carteira_acao
DB_USERNAME=carteira
DB_PASSWORD=troque-esta-senha

# Docker Compose
POSTGRES_DB=carteira_acao
POSTGRES_USER=carteira
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5433
APP_PORT=18080

# Usuario inicial opcional. Prefira criar a conta pela tela de cadastro.
DEMO_USER_ENABLED=false
DEMO_USER_EMAIL=admin@carteira.com
DEMO_USER_PASSWORD=troque-esta-senha

# Integracoes opcionais
BRAPI_TOKEN=
ALPHA_VANTAGE_API_KEY=demo
